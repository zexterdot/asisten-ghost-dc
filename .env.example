# Discord Bot Token (dari Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Bot Prefix (default: !)
BOT_PREFIX=!

# Your Discord User ID (untuk menerima log pesan dihapus via DM)
# Cara dapat ID: Aktifkan Developer Mode di Discord > Klik kanan profil kamu > Copy ID
OWNER_ID=your_discord_user_id_here

# PostgreSQL Database URL (dari Railway)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@host:5432/railway
